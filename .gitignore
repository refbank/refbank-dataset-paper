# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/
*_files/
# cached_model_files/ matches *_files/ but is not knitr output; its large fits are ignored further down
!cached_model_files/
# Temporary files created by R markdown
*.utf8.md
*.knit.md
*.html

hsp_2026/*
# R Environment Variables
.Renviron

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

*.png
*.aux
*.out
*.log
*.gz
*.wmf
*.svg
# Figure 1 (made by code/make_schema_diagram.R). The Rmd includes the .svg, but
# the PDF build uses the .png: LaTeX can't read svg, so knitr drops the extension
# and pdflatex finds the .png.
!manuscript/figs/schema_v3_solarized.svg
!manuscript/figs/schema_v3_solarized.png

cached_model_files/mods/*.rds
cached_model_files/mods.zip

*.DS_Store

